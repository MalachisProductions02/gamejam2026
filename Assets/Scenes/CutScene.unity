--- !u!114 &1892126164
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1892126163}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8a72cdcc2959cee4fa39bfe466aac6db, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textUI: {fileID: 563969125}
  tipografiaAlternativa: {fileID: 11400000, guid: 0161d805a3764c089bef00bfe00793f5, type: 2}
  audioSource: {fileID: 1878759086}
  frases:
  - texto: Everyone dies.
    duracion: 3
    usarTipografiaAlternativa: 0
    reproducirAudio: 1
    audio: {fileID: 8300000, guid: 8c259c762790bbd4984d9b2ba69955d8, type: 3}
  - texto: You know that.
    duracion: 3
    usarTipografiaAlternativa: 0
    reproducirAudio: 1
    audio: {fileID: 8300000, guid: 8c259c762790bbd4984d9b2ba69955d8, type: 3}
  - texto: So...
    duracion: 3
    usarTipografiaAlternativa: 0
    reproducirAudio: 1
    audio: {fileID: 8300000, guid: 8c259c762790bbd4984d9b2ba69955d8, type: 3}
  - texto: ...why am I afraid?
    duracion: 3
    usarTipografiaAlternativa: 0
    reproducirAudio: 1
    audio: {fileID: 8300000, guid: 8c259c762790bbd4984d9b2ba69955d8, type: 3}
  - texto: ...
    duracion: 6
    usarTipografiaAlternativa: 0
    reproducirAudio: 1
    audio: {fileID: 8300000, guid: 8c259c762790bbd4984d9b2ba69955d8, type: 3}
  - texto: I don't want to die.
    duracion: 3
    usarTipografiaAlternativa: 0
    reproducirAudio: 1
    audio: {fileID: 8300000, guid: 8c259c762790bbd4984d9b2ba69955d8, type: 3}
  - texto: Not yet.
    duracion: 3
    usarTipografiaAlternativa: 0
    reproducirAudio: 1
    audio: {fileID: 8300000, guid: 8c259c762790bbd4984d9b2ba69955d8, type: 3}
  - texto: But..
    duracion: 6
    usarTipografiaAlternativa: 0
    reproducirAudio: 1
    audio: {fileID: 8300000, guid: 8c259c762790bbd4984d9b2ba69955d8, type: 3}
  - texto: What does "yet" mean?
    duracion: 3
    usarTipografiaAlternativa: 0
    reproducirAudio: 1
    audio: {fileID: 8300000, guid: 8c259c762790bbd4984d9b2ba69955d8, type: 3}
  - texto: I don't want to die.
    duracion: 3
    usarTipografiaAlternativa: 0
    reproducirAudio: 1
    audio: {fileID: 8300000, guid: 8c259c762790bbd4984d9b2ba69955d8, type: 3}
  - texto: So why am I afraid?
    duracion: 3
    usarTipografiaAlternativa: 0
    reproducirAudio: 1
    audio: {fileID: 8300000, guid: 8c259c762790bbd4984d9b2ba69955d8, type: 3}
  - texto: Is it death?
    duracion: 3
    usarTipografiaAlternativa: 0
    reproducirAudio: 1
    audio: {fileID: 8300000, guid: 8c259c762790bbd4984d9b2ba69955d8, type: 3}
  - texto: I don't want to die.
    duracion: 3
    usarTipografiaAlternativa: 0
    reproducirAudio: 1
    audio: {fileID: 8300000, guid: 8c259c762790bbd4984d9b2ba69955d8, type: 3}
  - texto: I...
    duracion: 5
    usarTipografiaAlternativa: 0
    reproducirAudio: 1
    audio: {fileID: 8300000, guid: 8c259c762790bbd4984d9b2ba69955d8, type: 3}
  - texto: MEMENTO MORI
    duracion: 8
    usarTipografiaAlternativa: 1
    reproducirAudio: 1
    audio: {fileID: 8300000, guid: c57f583fa86549d4992466107ff6c48a, type: 3}
  retrasoInicial: 3
  objetoActivar: {fileID: 403512355}
  ocultarTextoAlFinal: 1
  duracionFadeOut: 2
